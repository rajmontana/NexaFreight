# ──────────────────────────────────────────────────────────────────────────
# NexaFreight frontend — local configuration
#
#   cp .env.local.example .env.local
#
# Only NEXT_PUBLIC_NEXA_API_URL is required. Everything else has a working
# default and exists so a demo can be pinned to fixed numbers.
# ──────────────────────────────────────────────────────────────────────────

# The FastAPI backend. `make dev-backend` serves on 127.0.0.1:8000.
# Must be reachable from the BROWSER, not just from the Next server —
# it is read by client components.
NEXT_PUBLIC_NEXA_API_URL=http://localhost:8000

# ── Currency ──────────────────────────────────────────────────────────────
# The backend computes and stores all money in USD. The UI presents rupees.
# Keep this identical to the backend's `fx.usd_inr` or the KPI band and the
# dossier cards will disagree with the financials table.
#
#   backend default: 95.8   (settings.fx.usd_inr)
#
# Pin it for a presentation so the headline figure cannot move mid-demo.
NEXT_PUBLIC_USD_INR=95.8

# ── Map ───────────────────────────────────────────────────────────────────
# MapLibre uses a style URL, not a Mapbox token. Leave unset to use the
# bundled style. Set only if you are serving your own tiles.
# NEXT_PUBLIC_MAP_STYLE_URL=

# ── Notes ─────────────────────────────────────────────────────────────────
# The analytics endpoints (/api/analytics/summary, /scorecard, /sla, /esg)
# all require a JWT. Sign in first — until you do, the KPI band renders its
# tiles as AUTH REQUIRED rather than fabricating zeroes.
