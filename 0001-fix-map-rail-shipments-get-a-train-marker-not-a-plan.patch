     <div style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 0 8px rgba(249,115,22,0.95));pointer-events:none;">
@@ -302,7 +317,7 @@ interface LiveMarkerRecord {
