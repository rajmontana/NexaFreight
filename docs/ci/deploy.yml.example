# Deploy to Hugging Face Spaces (free CPU) — activates when moved to
# .github/workflows/deploy.yml (same one-time step as ci.yml; see docs/ci/README.md)
name: Deploy

on:
  push:
    branches: [main]          # deploy only when work reaches main
  workflow_dispatch: {}       # or trigger manually from the Actions tab

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Smoke tests before deploy (rule: staging-before-prod)
        run: |
          pip install -r requirements.txt -r requirements-dev.txt
          ruff check .
          pytest

      - name: Push to Hugging Face Space
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
        run: |
          git config user.name "nexafreight-deploy"
          git config user.email "deploy@nexafreight.local"
          git remote add space https://USER:$$HF_TOKEN@huggingface.co/spaces/$HF_SPACE/hf-space-name.git || true
          # Replace $HF_SPACE with your HF username via repo variable, or hardcode below:
          git remote add space "https://user:$HF_TOKEN@huggingface.co/spaces/${{ vars.HF_SPACE }}/nexafreight.git" || true
          git push space main --force
