# Deploy to Hugging Face Spaces (free CPU) — activates when moved to
# .github/workflows/deploy.yml (one-time step; see docs/ci/README.md)
name: Deploy

on:
  push:
    branches: [main]          # deploy only when work reaches main
  workflow_dispatch: {}       # or trigger manually from the Actions tab

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Smoke tests before deploy (rule: staging-before-prod)
        run: |
          pip install -r requirements.txt -r requirements-dev.txt
          ruff check .
          pytest

      - name: Push to Hugging Face Space
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          HF_SPACE: ${{ vars.HF_SPACE }}   # repo variable: your HF username
        run: |
          git config user.name "nexafreight-deploy"
          git config user.email "deploy@nexafreight.local"
          git remote add space "https://deploy:${HF_TOKEN}@huggingface.co/spaces/${HF_SPACE}/nexafreight.git"
          git push space HEAD:main --force
