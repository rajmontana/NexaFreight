# SmartTrack™ Environment Configuration
# Copy this file to .env and customize values for production deployment

# Database Connection (Neon / Supabase / Render / Localhost)
DATABASE_URL=postgresql://postgres:admin321@localhost:5432/smart_track

# Cryptographic JWT Secret for Session Authentication
JWT_SECRET=smarttrack-nexafreight-secret-key-2025-production

# Live Satellite Maritime Feed (AISstream.io)
AISSTREAM_API_KEY=your_free_aisstream_api_key_here

# GenAI Copilot (Groq Llama-3.3-70B API Key)
GROQ_API_KEY=gsk_your_free_groq_key_here

# Cloud Server Configuration
HOST=0.0.0.0
PORT=8000
