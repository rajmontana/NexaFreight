# NexaFreight environment configuration
# Copy to .env and fill values. NEVER commit the real .env (git-ignored).

# --- Core -------------------------------------------------------------------
APP_ENV=dev                      # dev | staging | prod
DATABASE_URL=postgresql://nexa:nexa@localhost:5432/nexafreight
JWT_SECRET=change-me             # generate: openssl rand -base64 48
FEED_MODE=mock                   # live | replay | mock  (AGENTS.md §9)

# --- External feeds (needed from Phase 2 — leave empty until then) ----------
# AISSTREAM_API_KEY=             # free key: https://aisstream.io (GitHub login)
# OPENSKY_USERNAME=              # free account: https://opensky-network.org
# OPENSKY_PASSWORD=

# --- LLM copilot (needed from Phase 3) --------------------------------------
# GROQ_API_KEY=                  # free key: https://console.groq.com
